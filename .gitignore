node_modules/
dist/
.env
.DS_Store

# Durable server state — contains device tokens (reader→wallet secrets) and
# wallet↔meter PII. Must NEVER be committed.
state.json
state.json.tmp
server/state.json
server/state.json.tmp

# The bridge saves the device token next to itself so nobody has to paste it twice.
# Same secret, same rule: never commit it.
.gul-bridge.json

# Python bytecode / test caches — never ship these (HACS copies the whole
# custom_components directory into the user's Home Assistant).
__pycache__/
*.py[cod]
.pytest_cache/
