# ── Reward-distributor service environment ──────────────────────────────────
# Copy to ".env" and fill in. NEVER commit the real .env.

# Network: testnet | mainnet
NETWORK=testnet

# VeChain node (optional — defaults per network)
# NODE_URL=https://testnet.vechain.org

# VeBetterDAO app id (bytes32). Defaults to the Green Utility Log app.
APP_ID=0x489c6c122157f3b1072c2565b0eb6cb734564e84d14c80b1a12e6834a075f71e

# Private key of the wallet that holds the reward-distributor role for the app.
# No 0x prefix needed. Use a DEDICATED hot wallet — only this service should
# know it. NEVER commit this value.
DISTRIBUTOR_PRIVATE_KEY=

# CORS origin of your frontend (e.g. https://app.greenutilitylog.com). Use * for
# local development only.
ALLOWED_ORIGIN=*

# HTTP port
PORT=8787

# Cooldown per wallet+utility in milliseconds (default 20h = 72000000)
# COOLDOWN_MS=72000000

# Server-side OCR check (needs the optional tesseract.js dependency). The photo
# hash dedupe + image sanity always run; this additionally verifies the reading
# is visible in the photo. Leave off unless you've installed tesseract.js.
# OCR_ENABLED=true

# Google Cloud Vision API key — enables accurate meter-photo OCR on the /ocr
# endpoint (first 1000 images/month free). Get it in Google Cloud → Credentials,
# with the Cloud Vision API enabled. Leave empty to disable (app falls back to
# in-browser OCR). NEVER commit the real key.
# GOOGLE_VISION_API_KEY=

# Roboflow (a model trained on meter displays). Set the model as "project/version"
# and your API key. Free account at roboflow.com.
# ROBOFLOW_MODEL=ocr-meter-reading/3
# ROBOFLOW_API_KEY=

# Custom OCR service URL (e.g. a self-hosted YOLOv8 + OCR pipeline). It is POSTed
# { image } (base64) and should reply { text } and/or { numbers: [...] }.
# CUSTOM_OCR_URL=

# Order the OCR providers are tried in (first hit wins; unconfigured ones skipped).
# OCR_PROVIDER_ORDER=roboflow,custom,vision

# Wallet ownership proof: require a signed certificate on every /reward request and
# verify the signer matches the rewarded address. Keep "true" in production. Set
# false only for local testing without a wallet. Max certificate age in ms.
# REQUIRE_CERT=true
# CERT_MAX_AGE_MS=900000

# Where the durable state (cooldowns, used photo hashes, meter ownership) is
# stored. Single-instance JSON file by default; use Redis/Postgres for scale.
# STATE_FILE=./state.json

# ── Photo archive (OPTIONAL — for admin fraud review) ───────────────────────
# Off by default: submission photos are hashed and discarded (only a fingerprint
# is kept). Turn it on to instead keep a downscaled thumbnail of each rewarded
# photo, viewable per submission in the admin panel. Two backends — the first one
# configured wins (R2 preferred):
#
# A) Cloudflare R2 — big, free ≤10 GB, but activating R2 needs a card on file.
#    Create a bucket + API token (Object Read & Write) at dash.cloudflare.com → R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=greenutilitylog-photos
# R2_PREFIX=photos
#
# B) Upstash Redis — NO card, smaller (free ≤256 MB ≈ a few thousand thumbnails).
#    Reuses the SAME UPSTASH_REDIS_REST_* vars as the durable state above: if state
#    already runs on Upstash, photos are archived there automatically (thumbnails
#    self-expire via a Redis TTL). Nothing extra to set beyond those two vars.
#
# Auto-delete archived photos older than this many days (default 30; 0 = never).
# On R2 this drives an hourly cleanup sweep; on Upstash it becomes the key's TTL.
# PHOTO_RETENTION_DAYS=30
#
# ⚠️ R2 retention backstop: the R2 sweep uses an index kept in the durable state.
# If you run R2 WITHOUT Upstash (ephemeral-disk host), that index is lost on redeploy
# and old thumbnails would orphan. ALSO set a Cloudflare R2 bucket lifecycle rule
# (Object expiration = your retention days) as the server-side source of truth. Not
# needed when photos live in Upstash (native per-key TTL) or when Upstash backs state.
