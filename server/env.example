# ── Reward-distributor service environment ──────────────────────────────────
# Copy to ".env" (cp env.example .env) and fill in. NEVER commit the real .env.
# Every setting the server reads is listed here; commented ones show the default.

# Network: testnet | mainnet
NETWORK=testnet

# VeChain node (optional — defaults per network)
# NODE_URL=https://testnet.vechain.org

# VeBetterDAO app id (bytes32). Defaults to the Green Utility Log app.
APP_ID=0x489c6c122157f3b1072c2565b0eb6cb734564e84d14c80b1a12e6834a075f71e

# Private key of the wallet that holds the reward-distributor role for the app.
# No 0x prefix needed. Use a DEDICATED hot wallet — only this service should
# know it. NEVER commit this value.
DISTRIBUTOR_PRIVATE_KEY=

# CORS origin of your frontend (e.g. https://app.greenutilitylog.com). Use * for
# local development only.
ALLOWED_ORIGIN=*

# HTTP port
PORT=8787

# Cooldown per wallet+utility in milliseconds (default 20h = 72000000)
# COOLDOWN_MS=72000000

# Server-side OCR check (needs the optional tesseract.js dependency). The photo
# hash dedupe + image sanity always run; this additionally verifies the reading
# is visible in the photo. Leave off unless you've installed tesseract.js.
# OCR_ENABLED=true

# Google Cloud Vision API key — enables accurate meter-photo OCR on the /ocr
# endpoint (first 1000 images/month free). Get it in Google Cloud → Credentials,
# with the Cloud Vision API enabled. Leave empty to disable (app falls back to
# in-browser OCR). NEVER commit the real key.
# GOOGLE_VISION_API_KEY=

# Roboflow (a model trained on meter displays). Set the model as "project/version"
# and your API key. Free account at roboflow.com.
# ROBOFLOW_MODEL=ocr-meter-reading/3
# ROBOFLOW_API_KEY=

# Custom OCR service URL (e.g. a self-hosted YOLOv8 + OCR pipeline). It is POSTed
# { image } (base64) and should reply { text } and/or { numbers: [...] }.
# CUSTOM_OCR_URL=

# Order the OCR providers are tried in (first hit wins; unconfigured ones skipped).
# "claude" reads the meter with Claude vision and needs only ANTHROPIC_API_KEY.
# OCR_PROVIDER_ORDER=roboflow,custom,vision,claude
# OCR_CLAUDE_MODEL=claude-opus-4-8

# Is the TYPED reading actually on the photo? With any OCR provider above
# configured the server reads the photo itself at payout time.
#   strict (default with a provider) = refuse a mismatch
#   flag   = pay, but record it for admin review
#   off    = don't check
# Without a provider there is nothing to read the photo with, so this is off.
# READING_CHECK=strict

# /ocr needs no signature and every call costs money at a paid provider, so it is
# capped per UTC day, in total and per IP. Over the cap the app falls back to
# in-browser OCR. OCR_REQUIRE_CERT=true additionally demands a wallet signature
# (only once the app sends one with /ocr).
# OCR_DAILY_MAX=1000
# OCR_DAILY_PER_IP=40
# OCR_REQUIRE_CERT=false

# ── AI photo check (Claude vision) ──────────────────────────────────────────
# Set to refuse doctored / screen-captured / hand-drawn photos before paying. When
# set, the check fails CLOSED: if it cannot run, nothing is paid ("try again").
# The same key powers the "claude" OCR provider and so the reading check above.
# Each photo check costs a few cents with the default model; claude-haiku-4-5 is
# much cheaper. NEVER commit the real key.
# ANTHROPIC_API_KEY=
# AI_PHOTO_MODEL=claude-opus-4-8
# AI_PHOTO_MIN_CONFIDENCE=0.6
# How old a photo may be by its EXIF date before it is refused.
# PHOTO_MAX_AGE_DAYS=7

# Wallet ownership proof: require a signed certificate on every /reward request and
# verify the signer matches the rewarded address. Keep "true" in production. Set
# false only for local testing without a wallet. Max certificate age in ms.
# REQUIRE_CERT=true
# CERT_MAX_AGE_MS=900000
# Only accept signatures made on these sites (comma-separated). Leave empty until
# you've seen the real value: /health → certDomains.seen lists what arrives.
# CERT_DOMAINS=greenutilitylog.github.io

# Where the durable state (cooldowns, used photo hashes, meter ownership) is
# stored. Single-instance JSON file by default; use Redis/Postgres for scale.
# STATE_FILE=./state.json
#
# Durable state on Upstash Redis (free tier is plenty). Recommended on any host
# whose disk is wiped on redeploy (Render free). When set, STATE_FILE is ignored.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# STATE_KEY=greenutilitylog:state

# ── Photo archive (OPTIONAL — for admin fraud review) ───────────────────────
# Off by default: submission photos are hashed and discarded (only a fingerprint
# is kept). Turn it on to instead keep a downscaled thumbnail of each rewarded
# photo, viewable per submission in the admin panel. Two backends — the first one
# configured wins (R2 preferred):
#
# A) Cloudflare R2 — big, free ≤10 GB, but activating R2 needs a card on file.
#    Create a bucket + API token (Object Read & Write) at dash.cloudflare.com → R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=greenutilitylog-photos
# R2_PREFIX=photos
#
# B) Upstash Redis — NO card, smaller (free ≤256 MB ≈ a few thousand thumbnails).
#    Reuses the SAME UPSTASH_REDIS_REST_* vars as the durable state above: if state
#    already runs on Upstash, photos are archived there automatically (thumbnails
#    self-expire via a Redis TTL). Nothing extra to set beyond those two vars.
#
# Auto-delete archived photos older than this many days (default 30; 0 = never).
# On R2 this drives an hourly cleanup sweep; on Upstash it becomes the key's TTL.
# PHOTO_RETENTION_DAYS=30
#
# ⚠️ R2 retention backstop: the R2 sweep uses an index kept in the durable state.
# If you run R2 WITHOUT Upstash (ephemeral-disk host), that index is lost on redeploy
# and old thumbnails would orphan. ALSO set a Cloudflare R2 bucket lifecycle rule
# (Object expiration = your retention days) as the server-side source of truth. Not
# needed when photos live in Upstash (native per-key TTL) or when Upstash backs state.

# ── Distributor wallet, alternatives to DISTRIBUTOR_PRIVATE_KEY ──────────────
# A 12/24-word phrase instead of a key, and optionally which of its addresses to
# use. DISTRIBUTOR_DRY_RUN=true never sends a transaction (tests only — /health
# shows dryRun so a deployment can't do this by accident).
# DISTRIBUTOR_MNEMONIC=
# DISTRIBUTOR_ADDRESS=
# DISTRIBUTOR_DRY_RUN=false
# Pay gas through a VIP-191 fee-delegation service instead of the wallet's VTHO.
# DELEGATION_URL=

# ── Admins and blocked wallets ───────────────────────────────────────────────
# Wallets allowed into the admin endpoints (comma-separated). If unset, the code
# falls back to the project owners' two wallets — set this in your own deployment.
# ADMIN_WALLETS=0x...,0x...
# Wallets that may never claim, on top of the ones blocked from the admin panel.
# BANNED_ADDRESSES=
# Require an admin-issued pass before a wallet can claim.
# REQUIRE_PASS=false

# ── Reward rules ─────────────────────────────────────────────────────────────
# Rewards follow the weekly VeBetterDAO allocation: every payout is multiplied by
# min(1, daily budget / daily demand), where daily budget = B3TR in the pot ÷ days
# until the round ends, and daily demand = the last 7 days of payouts at full rates.
# /health → rewardBudget shows the numbers. "off" pays the fixed amounts below.
# REWARD_SCALING=on
# The server claims each ended round's allocation into the pot by itself (gas from
# the distributor wallet). "off" leaves that to someone else.
# AUTO_CLAIM_ALLOCATION=on
# Fix the pot and the days left instead of reading them from chain (tests, or a
# manual budget).
# BUDGET_POOL_B3TR=
# BUDGET_DAYS_LEFT=
# Most a single submission can pay (B3TR), whatever it covers.
# MAX_PAYOUT_PER_SUBMISSION=4
# Hard sanity ceiling checked on every payout.
# MAX_REWARD=50
# Longest gap between readings that still counts in full, in days.
# MAX_SPAN_DAYS=7
# Eco-mode photo bonus: amount, weekly limit, time between claims, week timezone.
# ECO_REWARD=2
# ECO_MAX_PER_WEEK=4
# ECO_COOLDOWN_MS=86400000
# ECO_TZ=Europe/Amsterdam

# ── Automatic readings (P1 readers, Home Assistant, Enode) ───────────────────
# How old a pushed reading may be when it is claimed (default 48h).
# METER_MAX_AGE_MS=172800000
# Claim every paired reader's latest reading on a timer (ms, at least 60000; 0=off).
# AUTO_SUBMIT_MS=0
# Public URL of this service, used in the pairing instructions it hands out.
# PUBLIC_BASE_URL=https://greenutilitylog-rewards.onrender.com
# Enode (smart-meter API). Leave unset to disable.
# ENODE_CLIENT_ID=
# ENODE_CLIENT_SECRET=
# ENODE_ENV=sandbox
# ENODE_API_URL=
# ENODE_OAUTH_URL=
# ENODE_REDIRECT_URI=https://greenutilitylog.github.io/GreenUtilityLog/
# ENODE_READING_FIELD=

# ── Hosting ──────────────────────────────────────────────────────────────────
# Reverse proxies in front of this service (Render: 1). Decides which IP the rate
# limit sees; too high lets clients forge it.
# TRUST_PROXY_HOPS=1
# Cloudflare Turnstile captcha secret (the site key goes in the app).
# TURNSTILE_SECRET=
# Commit shown on /health. Render sets RENDER_GIT_COMMIT by itself.
# GIT_COMMIT=
